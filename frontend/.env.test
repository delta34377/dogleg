# Used ONLY by `npm test` (Create React App loads .env.test when NODE_ENV=test).
#
# The app's Supabase client (src/services/supabase.js) refuses to start
# without a URL and key, so tests that import anything touching it would
# crash before running. These are dummy values that point at nothing real:
# they are NOT secrets, and the tests mock every network call.
REACT_APP_SUPABASE_URL=http://localhost:54321
REACT_APP_SUPABASE_ANON_KEY=test-anon-key
