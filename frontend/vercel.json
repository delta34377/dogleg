{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/rounds/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/join/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/rounds/:code",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?:facebookexternalhit|Facebot|Twitterbot|Slackbot|WhatsApp|TelegramBot|Discordbot|LinkedInBot|Pinterestbot|Pinterest/0\\.|redditbot|Applebot|Googlebot|bingbot|Embedly|Iframely|SkypeUriPreview|vkShare).*"
        }
      ],
      "destination": "/api/og/round?code=:code"
    },
    {
      "source": "/join/:username",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?:facebookexternalhit|Facebot|Twitterbot|Slackbot|WhatsApp|TelegramBot|Discordbot|LinkedInBot|Pinterestbot|Pinterest/0\\.|redditbot|Applebot|Googlebot|bingbot|Embedly|Iframely|SkypeUriPreview|vkShare).*"
        }
      ],
      "destination": "/api/og/invite?username=:username"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
